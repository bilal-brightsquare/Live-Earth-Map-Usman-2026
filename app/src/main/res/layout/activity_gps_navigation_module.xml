<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_height="match_parent">


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_gpsnavigation"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/framelayout_gpsnavigation_bannerad"
        app:layout_constraintVertical_bias="0.0"
        map:cameraBearing="112.5"
        map:cameraTargetLat="-33.796923"
        map:cameraTargetLng="150.922433"
        map:cameraTilt="30"
        map:cameraZoom="13"
        map:mapType="normal"
        map:uiCompass="false"
        map:uiRotateGestures="true"
        map:uiScrollGestures="true"
        map:uiTiltGestures="true"
        map:uiZoomControls="false"
        map:uiZoomGestures="true" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/round10_shape"

        map:layout_constraintEnd_toEndOf="parent"
        map:layout_constraintStart_toStartOf="parent"
        map:layout_constraintTop_toBottomOf="@+id/toolbar_gpsnavigation">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edittext_gpsnavigation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:drawableStart="@drawable/edittext_location_icon"
            android:drawablePadding="10sp"
            android:hint="@string/enter_location_here"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16sp"
            android:textColor="#6c7a92"
            android:textColorHint="#959DAA"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintVertical_bias="0.0"
            map:layout_constraintBottom_toBottomOf="parent"
            map:layout_constraintEnd_toStartOf="@+id/button_gpsnavigation_voiceinput"
            map:layout_constraintStart_toStartOf="parent"
            map:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_voiceinput"
            android:layout_width="63dp"
            android:layout_height="52dp"
            android:layout_marginEnd="-4dp"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/voiceinput_icon"
            map:layout_constraintBottom_toBottomOf="parent"
            map:layout_constraintEnd_toEndOf="parent"
            map:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/layout_suggest_address_gpsnavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10sp"
        android:backgroundTint="@color/white"
        android:layout_marginEnd="16dp"
        android:outlineAmbientShadowColor="@color/black"
        android:outlineSpotShadowColor="@color/black"
        android:visibility="gone"
        app:cardElevation="20sp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
        tools:targetApi="p">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="0dp"
            android:layout_marginVertical="0dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="5">

                <TextView
                    android:id="@+id/suggestheader_gpsnavigation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="4.2"
                    android:text=""
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:drawablePadding="10sp"
                    app:drawableStartCompat="@drawable/edittext_location_icon"
                    app:drawableTint="@color/black" />

                <ProgressBar
                    android:id="@+id/progressbar_suggestlayout_gpsnavigation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="0.8"
                    android:paddingVertical="4dp"
                    android:indeterminateTint="@color/colorPrimary"
                    android:visibility="invisible" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <TextView
                android:id="@+id/suggestsub_gpsnavigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="5dp"
                android:maxLines="1"
                android:textColor="#6C6C6C"
                android:textSize="14sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutCompat"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="20dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_suggest_address_gpsnavigation">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_car"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/car_icon_gpsnavigation" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_bike"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/bike_icon_gpsnavigation" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_bicycle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/bicycle_icon_gpsnavigation" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_walk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/padestrial_icon_gpsnavigation" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_gpsnavigation_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:backgroundTint="@android:color/transparent"
        android:src="@drawable/share_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayoutCompat" />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="190dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:weightSum="5"
        app:layout_constraintBottom_toTopOf="@+id/button_gpsnavigation_navigation"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_zoomout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_zoom_out_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_zoomin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_zoom_in_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"

            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_current_location_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_saveaddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/save_address_icon" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_gpsnavigation_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@android:color/transparent"
        android:src="@drawable/map_navigate_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="250dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:weightSum="5"
        map:layout_constraintBottom_toBottomOf="parent"
        map:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_night"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_night_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_traffic_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_3d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_three_d_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_satellite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_satellite_icon" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:src="@drawable/map_default_icon_selected" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_gpsnavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/framelayout_gpsnavigation_bannerad">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_backpress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:backgroundTint="@android:color/transparent"
            android:scaleType="fitXY"
            android:tint="@color/white"
            android:src="@drawable/backpress_icon" />

        <TextView
            android:id="@+id/toolbar_gpsnavigation_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="0dp"
            android:fontFamily="@font/quicksand_bold"
            android:text="GPS Navigation"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_gpsnavigation_premium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:visibility="gone"
            android:layout_marginEnd="16sp"
            android:backgroundTint="@android:color/transparent"
            android:scaleType="fitXY"
            android:src="@drawable/premium_icon_all" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout_markerdetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/map_gpsnavigation"
        app:layout_constraintEnd_toEndOf="@+id/map_gpsnavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/map_gpsnavigation">

        <include layout="@layout/custom_map_marker" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="6dp"
        android:id="@+id/btn_live_view"
        android:layout_marginBottom="32dp"
        android:background="@drawable/btn_background"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_gravity="center"
            android:tint="@color/white"
            android:paddingTop="4dp"
            android:layout_height="24dp"
            android:src="@drawable/ive"/>

        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand_bold"
            android:textSize="16sp"
            android:text="Live View"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_gravity="center"
            android:layout_height="50dp"
            android:src="@drawable/premium"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>